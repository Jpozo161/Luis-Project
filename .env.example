POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me
POSTGRES_DB=n8n

# Generar con: openssl rand -hex 32  (no cambiar después de crear credenciales)
N8N_ENCRYPTION_KEY=change_me

N8N_HOST=localhost
N8N_PROTOCOL=http
# URL pública para webhooks (ej. túnel ngrok/cloudflared en local)
WEBHOOK_URL=http://localhost:5678/
# true cuando se sirva por HTTPS
N8N_SECURE_COOKIE=false

TIMEZONE=America/Lima
